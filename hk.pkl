// Pre-push checks: the shared base from timmo001/workflows, plus the CLI's
// lint. Types, tests and the plugin checks are left to `mise run check`,
// `mise run check:plugin` and CI. Run the hook's steps by hand with
// `hk check --all`.
amends "package://github.com/timmo001/workflows/releases/download/20261108.2/hk-base@20261108.2.0#/base.pkl"

// Shared skills are synced copies owned by the skills repository. PKGBUILDs are
// makepkg scripts that shellcheck can't follow, and CI doesn't lint them either.
exclude = List(".agents/skills", ".mise", ".scripts/linux/PKGBUILD*")

hooks {
  ["pre-push"] {
    steps {
      ["lint"] {
        check = "mise run lint"
      }
    }
  }
}
